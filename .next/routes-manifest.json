{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/static(?:/(.*))(?:/)?$"
    }
  ],
  "dynamicRoutes": [
    {
      "page": "/codigo-postal/[slug]",
      "regex": "^/codigo\\-postal/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/codigo\\-postal/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/localidades/[distrito]",
      "regex": "^/localidades/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPdistrito": "nxtPdistrito"
      },
      "namedRegex": "^/localidades/(?<nxtPdistrito>[^/]+?)(?:/)?$"
    },
    {
      "page": "/localidades/[distrito]/[concelho]",
      "regex": "^/localidades/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPdistrito": "nxtPdistrito",
        "nxtPconcelho": "nxtPconcelho"
      },
      "namedRegex": "^/localidades/(?<nxtPdistrito>[^/]+?)/(?<nxtPconcelho>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/codigo-postal",
      "regex": "^/codigo\\-postal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/codigo\\-postal(?:/)?$"
    },
    {
      "page": "/feriados",
      "regex": "^/feriados(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/feriados(?:/)?$"
    },
    {
      "page": "/iban",
      "regex": "^/iban(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/iban(?:/)?$"
    },
    {
      "page": "/localidades",
      "regex": "^/localidades(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/localidades(?:/)?$"
    },
    {
      "page": "/nif",
      "regex": "^/nif(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/nif(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/simuladores",
      "regex": "^/simuladores(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/simuladores(?:/)?$"
    },
    {
      "page": "/simuladores/credito-habitacao",
      "regex": "^/simuladores/credito\\-habitacao(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/simuladores/credito\\-habitacao(?:/)?$"
    },
    {
      "page": "/simuladores/iva",
      "regex": "^/simuladores/iva(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/simuladores/iva(?:/)?$"
    },
    {
      "page": "/simuladores/juros-compostos",
      "regex": "^/simuladores/juros\\-compostos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/simuladores/juros\\-compostos(?:/)?$"
    },
    {
      "page": "/simuladores/salario-liquido",
      "regex": "^/simuladores/salario\\-liquido(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/simuladores/salario\\-liquido(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}